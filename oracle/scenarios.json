  "normalization": {
    "states": {
      "completed": "succeeded",
      "queued": "available"
    },
    "excluded": ["generated identifiers", "absolute timestamps"],
    "clock": "Database future/due relation; no absolute cross-process timestamp equality.",
    "completion": "Read the committed row after public drain/process calls. Worker invocation counts alone never establish completion.",
    "configured_delay": "Before/after PostgreSQL clock bracket around the public action; persisted due time must equal configured delay within that bracket plus 20ms clock tolerance; bracket spans over 5000ms fail."
  },
