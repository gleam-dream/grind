  "gaps": [
    {
      "id": "fenced-expiry-and-audited-replay",
      "classification": "intentional-grind-semantics",
      "reason": "Grind never automatically re-executes an expired ambiguous attempt; configured Oban Lifeline rescues aged attempts. Independent-VM M2 expectations and adapters live in oracle/fault-scenarios.json; those separate executions are not counted among this catalog's twelve paired cases.",
      "sources": [
        "src/grind/internal/lease.gleam",
        "oracle/deps/oban/lib/oban/lifeline.ex",
        "oracle/fault-scenarios.json"
      ]
    },
    {
      "id": "durable-ack-and-admission-receipts",
      "classification": "intentional-grind-semantics",
      "reason": "Grind has durable caller reconciliation identities absent from Oban Basic; dedicated Grind fault tests remain authoritative.",
      "sources": [
        "src/grind/submission.gleam",
        "test/grind/queue/ack_failure_test.gleam"
      ]
    },
    {
      "id": "unique-json-and-opt-in",
      "classification": "intentional-grind-semantics",
      "reason": "Grind exact encoded key equality and opt-in participation differ from Oban JSON containment and visibility of ordinary jobs.",
      "sources": [
        "docs/UNIQUENESS-CONTRACT.md",
        "oracle/deps/oban/lib/oban/engines/basic.ex"
      ]
    },
    {
      "id": "default-backoff",
      "classification": "intentional-grind-semantics",
      "reason": "Grind exponential backoff differs from Oban polynomial jitter; paired retry cases explicitly configure equal delays.",
      "sources": [
        "src/grind/worker.gleam",
        "oracle/deps/oban/lib/oban/worker.ex"
      ]
    },
    {
      "id": "priority-and-queue-controls",
      "classification": "missing-accidental-divergence",
      "reason": "Priorities and pause/scale are Oban capabilities with no equivalent Grind surface. No passing scenario is claimed.",
      "sources": ["src/grind/queue.gleam", "oracle/deps/oban/lib/oban.ex"]
    },
    {
      "id": "transaction-enqueue-and-testing-helpers",
      "classification": "deferred",
      "reason": "Approved before-1.0 API work, not an initial-release parity prerequisite.",
      "sources": [
        "src/grind/postgres.gleam",
        "oracle/deps/oban/lib/oban/testing.ex"
      ]
    },
    {
      "id": "cron-reindexer-peer-notifiers",
      "classification": "deferred",
      "reason": "Owner explicitly deferred feature parity for Cron, Reindexer, leader election, and notification infrastructure. oracle/fault-scenarios.json separately specifies Oban M6 Peer failover against Grind's intentional concurrent-pruning design.",
      "sources": [
        "oracle/deps/oban/lib/oban/cron.ex",
        "oracle/deps/oban/lib/oban/reindexer.ex",
        "oracle/deps/oban/lib/oban/peer.ex",
        "oracle/deps/oban/lib/oban/notifier.ex",
        "oracle/fault-scenarios.json"
      ]
    },
    {
      "id": "multi-node-faults-and-throughput",
      "classification": "missing-accidental-divergence",
      "reason": "This deterministic behavior adapter does not measure node/connection loss, slow commit, pool starvation, or throughput. Dedicated resilience and benchmark suites must supply those release proofs.",
      "sources": ["docs/RELEASE-READINESS.md", "scripts/bench-matrix.sh"]
    }
  ]
